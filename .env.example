# Copie este arquivo para `.env` e preencha com o Client ID do Google Cloud.
# Console: https://console.cloud.google.com/apis/credentials
# Tipo: ID do cliente OAuth (aplicativo da Web)
# Origens JavaScript autorizadas (as duas):
#   http://localhost:5173
#   http://localhost:5174
# URIs de redirecionamento (as duas):
#   http://localhost:5173
#   http://localhost:5174

VITE_GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com
